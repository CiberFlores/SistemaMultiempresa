rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // A. AUTENTICACION Y USUARIOS
    // ==========================================

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      );
    }

    function hasProfile() {
      return signedIn() &&
        exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        );
    }

    // La cuenta de la persona está habilitada
    function userEnabled() {
      return hasProfile() &&
        request.auth.token.email_verified == true &&
        me().data.estado == true;
    }

    // Su empresa no está suspendida (el super admin no pertenece a ninguna)
    function companyEnabled() {
      return me().data.tipoUsuario == 'SUPER_ADMIN' ||
        me().data.get('empresaId', null) == null ||
        get(
          /databases/$(database)/documents/empresas/$(me().data.empresaId)
        ).data.get('estado', 'ACTIVA') != 'SUSPENDIDA';
    }

    function active() {
      return userEnabled() && companyEnabled();
    }

    function typeIs(t) {
      return active() &&
        me().data.tipoUsuario == t;
    }

    function superAdmin() {
      return typeIs('SUPER_ADMIN');
    }

    function admin() {
      return typeIs('ADMIN');
    }

    function worker() {
      return typeIs('TRABAJADOR');
    }

    function myCompany() {
      return hasProfile()
        ? me().data.empresaId
        : null;
    }

    function sameCompany(companyId) {
      return active() &&
        companyId != null &&
        myCompany() == companyId;
    }

    // ==========================================
    // B. ROLES Y PERMISOS
    // ==========================================

    function roleDoc() {
      return get(
        /databases/$(database)/documents/rolesEmpresa/$(me().data.rolId)
      );
    }

    // Tiene al menos uno de los permisos de la lista.
    // Se revisa la cuenta y el cargo una sola vez: repetir esa revisión por cada
    // permiso hacía que Firestore rechazara las reglas con muchas opciones.
    function hasAnyPermission(lista) {
      let yo = me().data;

      return active() && (
        yo.tipoUsuario == 'ADMIN' || (
          yo.tipoUsuario == 'TRABAJADOR' &&
          yo.rolId != null &&
          exists(
            /databases/$(database)/documents/rolesEmpresa/$(yo.rolId)
          ) &&
          roleDoc().data.empresaId == yo.empresaId &&
          roleDoc().data.estado == 'ACTIVO' &&
          roleDoc().data.permisos.hasAny(lista)
        )
      );
    }

    function hasPermission(permission) {
      return hasAnyPermission([permission]);
    }

    // ==========================================
    // C. PROTECCION MULTIEMPRESA
    // ==========================================

    function sameExistingCompany() {
      return resource.data.empresaId != null &&
        sameCompany(resource.data.empresaId);
    }

    function sameNewCompany() {
      return request.resource.data.empresaId != null &&
        sameCompany(request.resource.data.empresaId);
    }

    function sameOnUpdate() {
      return sameExistingCompany() &&
        request.resource.data.empresaId ==
          resource.data.empresaId;
    }

    // ==========================================
    // D. RUTAS PARA OPERACIONES DE LOTES
    // ==========================================

    function rutaInventario(sucursalId, productoId) {
      return /databases/$(database)/documents/inventarios/$(sucursalId + '_' + productoId);
    }

    function rutaMovimiento(id) {
      return /databases/$(database)/documents/movimientosStock/$(id);
    }

    function rutaLote(id) {
      return /databases/$(database)/documents/lotesInventario/$(id);
    }

    // ==========================================
    // E. PAGOS A PROVEEDORES DESDE LA CAJA
    // ==========================================

    function validFinanceCashMovement(id) {

      let m = request.resource.data;

      let esPago =
        m.tipo == 'EGRESO' &&
        m.categoria == 'PAGO_PROVEEDOR';

      let pagoPath =
        /databases/$(database)/documents/pagosProveedor/$(id);

      let cajaPath =
        /databases/$(database)/documents/cajas/$(m.cajaId);

      return
        hasPermission('finanzas.gestionar') &&

        m.keys().hasAll([
          'empresaId',
          'sucursalId',
          'cajaId',
          'tipo',
          'categoria',
          'monto',
          'metodoPago',
          'cuentaId',
          'pagoId',
          'usuarioId'
        ]) &&

        esPago &&

        m.metodoPago == 'EFECTIVO' &&

        m.monto is number &&
        m.monto > 0 &&

        m.pagoId == id &&

        m.usuarioId == request.auth.uid &&

        m.cajaId is string &&

        !exists(pagoPath) &&

        exists(cajaPath) &&

        get(cajaPath).data.empresaId ==
          m.empresaId &&

        get(cajaPath).data.sucursalId ==
          m.sucursalId &&

        get(cajaPath).data.estado ==
          'ABIERTA' &&

        getAfter(pagoPath).data.empresaId ==
          m.empresaId &&

        getAfter(pagoPath).data.cuentaId ==
          m.cuentaId &&

        getAfter(pagoPath).data.monto ==
          m.monto &&

        getAfter(pagoPath).data.cajaId ==
          m.cajaId &&

        getAfter(pagoPath).data.metodoPago ==
          'EFECTIVO' &&

        getAfter(pagoPath).data.usuarioId ==
          request.auth.uid &&

        getAfter(pagoPath).data.tipo ==
          'PAGAR';
    }

    // ==========================================
    // F. USUARIOS
    // ==========================================

    match /usuarios/{uid} {

      allow read: if
        superAdmin() ||
        // También con la cuenta bloqueada: así se le explica por qué no entra
        (
          signedIn() &&
          request.auth.token.email_verified == true &&
          request.auth.uid == uid
        ) ||
        (
          admin() &&
          resource.data.empresaId == myCompany()
        );

      allow create: if
        superAdmin() ||
        (
          admin() &&
          request.resource.data.empresaId == myCompany() &&
          request.resource.data.tipoUsuario == 'TRABAJADOR'
        );

      allow update: if

        superAdmin()

        ||

        (
          active() &&
          request.auth.uid == uid &&

          // Cada persona solo toca sus datos de contacto y su presencia
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'conectado', 'enPos', 'ultimaActividad', 'ultimoAcceso',
            'correoVerificado', 'nombreCompleto', 'telefono',
            'imagenPerfilUrl', 'fechaActualizacion'
          ]) &&

          request.resource.data.tipoUsuario ==
            resource.data.tipoUsuario &&

          request.resource.data.empresaId ==
            resource.data.empresaId &&

          (
            !worker() ||
            (
              request.resource.data.rolId ==
                resource.data.rolId &&

              request.resource.data.estado ==
                resource.data.estado &&

              request.resource.data.sucursales ==
                resource.data.sucursales
            )
          )
        )

        ||

        (
          admin() &&

          resource.data.empresaId ==
            myCompany() &&

          resource.data.tipoUsuario ==
            'TRABAJADOR' &&

          request.resource.data.tipoUsuario ==
            'TRABAJADOR' &&

          request.resource.data.empresaId ==
            resource.data.empresaId
        );

      allow delete: if false;
    }

    // ==========================================
    // G. EMPRESAS
    // ==========================================

    function colorHexValido(valor) {
      return valor is string &&
        valor.matches('^#[0-9a-fA-F]{6}$');
    }

    function logoValido(valor) {
      return valor is string &&
        (valor == '' || valor.matches('^https://.*'));
    }

    match /empresas/{empresaId} {

      // Una empresa suspendida puede leer su propio estado para mostrar el aviso
      allow read: if
        superAdmin() ||
        (
          userEnabled() &&
          myCompany() == empresaId
        );

      allow create, delete: if superAdmin();

      allow update: if
        superAdmin() ||
        (
          admin() &&
          myCompany() == empresaId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['logoUrl', 'identidad', 'fechaActualizacion']) &&
          logoValido(request.resource.data.logoUrl) &&
          request.resource.data.identidad.keys()
            .hasOnly([
              'colorPrimario',
              'colorSecundario',
              'fondo',
              'tipografia',
              'nombreVisual'
            ]) &&
          colorHexValido(request.resource.data.identidad.colorPrimario) &&
          colorHexValido(request.resource.data.identidad.colorSecundario) &&
          colorHexValido(request.resource.data.identidad.fondo)
        ) ||
        (
          // El dueño sube el QR con el que sus clientes pagan
          admin() &&
          myCompany() == empresaId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['qrCobroUrl', 'qrCobroActivo', 'fechaActualizacion']) &&
          logoValido(request.resource.data.get('qrCobroUrl', '')) &&
          request.resource.data.get('qrCobroActivo', true) is bool
        );
    }

    // ==========================================
    // H. MODULOS
    // ==========================================

    match /modulos/{id} {
      allow read: if active();
      allow write: if superAdmin();
    }

    match /planes/{id} {
      allow read: if active();
      allow write: if superAdmin();
    }

    match /licencias/{id} {

      allow read: if
        superAdmin() ||
        (
          active() &&
          resource.data.empresaId == myCompany()
        );

      allow write: if superAdmin();
    }

    match /modulosEmpresa/{empresaId} {

      allow read: if
        superAdmin() ||
        (
          active() &&
          myCompany() == empresaId
        );

      allow write: if superAdmin();
    }

    // ==========================================
    // I. PERSONALIZACION
    // SOLO SUPER_ADMIN
    // ==========================================

    match /personalizacionesEmpresas/{empresaId} {

      allow read: if
        superAdmin() ||
        (
          active() &&
          myCompany() == empresaId
        );

      allow write: if superAdmin();

      // El dueño solo puede cambiar los colores y el logo de su propia empresa.
      allow create: if
        admin() &&
        myCompany() == empresaId &&
        request.resource.data.keys()
          .hasOnly([
            'empresaId',
            'colorPrimario',
            'colorSecundario',
            'fondo',
            'logoUrl',
            'fechaActualizacion'
          ]) &&
        request.resource.data.empresaId == empresaId &&
        colorHexValido(request.resource.data.colorPrimario) &&
        colorHexValido(request.resource.data.colorSecundario) &&
        colorHexValido(request.resource.data.fondo) &&
        logoValido(request.resource.data.logoUrl);

      allow update: if
        admin() &&
        myCompany() == empresaId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'colorPrimario',
            'colorSecundario',
            'fondo',
            'logoUrl',
            'fechaActualizacion'
          ]) &&
        colorHexValido(request.resource.data.colorPrimario) &&
        colorHexValido(request.resource.data.colorSecundario) &&
        colorHexValido(request.resource.data.fondo) &&
        logoValido(request.resource.data.logoUrl);
    }

    match /configuracionesEmpresas/{empresaId} {

      allow read: if
        superAdmin() ||
        (
          active() &&
          myCompany() == empresaId
        );

      allow write: if
        superAdmin() ||
        (
          admin() &&
          myCompany() == empresaId
        );
    }

    // ==========================================
    // J. ROLES EMPRESARIALES
    // ==========================================

    match /rolesEmpresa/{id} {

      allow read: if
        superAdmin() ||
        sameExistingCompany();

      allow create: if
        admin() &&
        sameNewCompany();

      allow update: if
        admin() &&
        sameOnUpdate();

      allow delete: if
        admin() &&
        sameExistingCompany();
    }

    // ==========================================
    // K. SUCURSALES
    // ==========================================

    match /sucursales/{id} {

      allow read: if
        superAdmin() ||
        sameExistingCompany();

      allow create: if
        admin() &&
        sameNewCompany();

      allow update: if
        admin() &&
        sameOnUpdate();

      allow delete: if
        admin() &&
        sameExistingCompany();
    }

    // ==========================================
    // L. CATEGORIAS
    // ==========================================

    match /categorias/{id} {

      allow read: if
        superAdmin() ||
        sameExistingCompany();

      allow create: if
        hasPermission('categorias.gestionar') &&
        sameNewCompany();

      allow update: if
        hasPermission('categorias.gestionar') &&
        sameOnUpdate();

      allow delete: if
        hasPermission('categorias.gestionar') &&
        sameExistingCompany();
    }

    // ==========================================
    // M. MARCAS
    // ==========================================

    match /marcas/{id} {

      allow read: if
        superAdmin() ||
        sameExistingCompany();

      allow create: if
        hasPermission('marcas.gestionar') &&
        sameNewCompany();

      allow update: if
        hasPermission('marcas.gestionar') &&
        sameOnUpdate();

      allow delete: if
        hasPermission('marcas.gestionar') &&
        sameExistingCompany();
    }

    // ==========================================
    // N. PRODUCTOS
    // ==========================================

    match /productos/{id} {

      allow read: if
        superAdmin() ||
        sameExistingCompany();

      allow create: if
        hasPermission('productos.gestionar') &&
        sameNewCompany();

      // PROTEGER EL CONTROL DE VENCIMIENTOS.
      // SI YA ESTABA ACTIVADO NO SE DESACTIVA
      // DESDE LA APLICACION CLIENTE.

      allow update: if
        hasPermission('productos.gestionar') &&
        sameOnUpdate() &&

        (
          resource.data.get(
            'controlaVencimiento',
            false
          ) != true ||

          request.resource.data.controlaVencimiento == true
        );

      allow delete: if
        hasPermission('productos.gestionar') &&
        sameExistingCompany();
    }

    // ==========================================
    // O. INVENTARIO GENERAL
    // ==========================================

    match /inventarios/{id} {

      // CONSULTAR INVENTARIO.

      allow get: if
        superAdmin() ||
        (hasPermission('reportes.ver') && sameExistingCompany()) ||

        (
          (
            hasAnyPermission(['inventario.ver', 'inventario.ajustar', 'compras.gestionar', 'ventas.registrar', 'ventas.ver'])
          ) &&

          (
            resource == null ||
            sameExistingCompany()
          )
        );

      allow list: if
        superAdmin() ||
        (hasPermission('reportes.ver') && sameExistingCompany()) ||

        (
          (
            hasAnyPermission(['inventario.ver', 'inventario.ajustar', 'compras.gestionar', 'ventas.registrar', 'ventas.ver'])
          ) &&

          sameExistingCompany()
        );

      // CREAR EXISTENCIAS NORMALES.

      allow create: if

        (
          hasAnyPermission(['inventario.ajustar', 'compras.gestionar', 'ventas.registrar'])
        ) &&

        sameNewCompany() &&

        !request.resource.data.keys().hasAny([
          'regularizacionVersion',
          'ultimaRegularizacionId'
        ]);

      // ACTUALIZAR STOCK NORMAL O
      // REGULARIZAR LOTES SIN AUMENTAR STOCK.

      allow update: if
        sameOnUpdate() &&

        (

          // MOVIMIENTO NORMAL DE EXISTENCIAS.

          (
            (
              hasAnyPermission(['inventario.ajustar', 'compras.gestionar', 'ventas.registrar', 'ventas.ver'])
            ) &&

            request.resource.data.diff(
              resource.data
            ).affectedKeys().hasOnly([
              'stock',
              'fechaActualizacion'
            ]) &&

            request.resource.data.stock is number &&
            request.resource.data.stock >= 0
          )

          ||

          // REGULARIZACION DE EXISTENCIAS
          // ANTIGUAS SIN LOTE.

          (
            hasPermission('inventario.ajustar') &&

            request.resource.data.diff(
              resource.data
            ).affectedKeys().hasOnly([
              'regularizacionVersion',
              'ultimaRegularizacionId',
              'fechaActualizacion'
            ]) &&

            request.resource.data.stock ==
              resource.data.stock &&

            request.resource.data.regularizacionVersion ==
              resource.data.get('regularizacionVersion', 0) + 1 &&

            request.resource.data.ultimaRegularizacionId is string &&

            request.resource.data.fechaActualizacion ==
              request.time &&

            getAfter(
              rutaMovimiento(
                request.resource.data.ultimaRegularizacionId
              )
            ).data.tipo == 'REGULARIZACION_LOTE' &&

            getAfter(
              rutaMovimiento(
                request.resource.data.ultimaRegularizacionId
              )
            ).data.empresaId ==
              resource.data.empresaId &&

            getAfter(
              rutaMovimiento(
                request.resource.data.ultimaRegularizacionId
              )
            ).data.sucursalId ==
              resource.data.sucursalId &&

            getAfter(
              rutaMovimiento(
                request.resource.data.ultimaRegularizacionId
              )
            ).data.productoId ==
              resource.data.productoId &&

            getAfter(
              rutaLote(
                getAfter(
                  rutaMovimiento(
                    request.resource.data.ultimaRegularizacionId
                  )
                ).data.loteId
              )
            ).data.regularizacionId ==
              request.resource.data.ultimaRegularizacionId
          )
        );

      allow delete: if false;
    }

    // ==========================================
    // P. MOVIMIENTOS DE INVENTARIO
    // ==========================================

    match /movimientosStock/{id} {

      allow read: if
        superAdmin() ||

        (
          hasPermission('inventario.ver') &&
          sameExistingCompany()
        );

      allow create: if
        sameNewCompany() &&

        (

          // REGULARIZACION DE LOTE.

          (
            request.resource.data.tipo ==
              'REGULARIZACION_LOTE' &&

            hasPermission('inventario.ajustar') &&

            request.resource.data.usuarioId ==
              request.auth.uid &&

            request.resource.data.cantidad is number &&
            request.resource.data.cantidad > 0 &&

            request.resource.data.stockAnterior ==
              request.resource.data.stockNuevo &&

            request.resource.data.fechaRegistro ==
              request.time &&

            getAfter(
              rutaLote(
                request.resource.data.loteId
              )
            ).data.regularizacionId == id &&

            getAfter(
              rutaInventario(
                request.resource.data.sucursalId,
                request.resource.data.productoId
              )
            ).data.ultimaRegularizacionId == id
          )

          ||

          // MOVIMIENTOS NORMALES.

          (
            request.resource.data.tipo !=
              'REGULARIZACION_LOTE' &&

            (
              hasAnyPermission(['inventario.ajustar', 'compras.gestionar', 'ventas.registrar', 'ventas.ver'])
            )
          )
        );

      allow update, delete: if false;
    }

    // ==========================================
    // Q. CONTROL DE LOTES
    // ==========================================

    match /lotesInventario/{id} {

      // ========================================
      // CONSULTAR LOTES
      // ========================================

      allow read: if
        superAdmin() ||
        (hasPermission('reportes.ver') && sameExistingCompany()) ||

        (
          (
            hasAnyPermission(['inventario.ver', 'inventario.ajustar', 'compras.gestionar', 'ventas.registrar', 'ventas.ver'])
          ) &&

          sameExistingCompany()
        );

      // ========================================
      // CREAR LOTES
      // ========================================

      // PERMITE:
      // 1. COMPRAS CON LOTES.
      // 2. REGULARIZACION DE EXISTENCIAS.

      allow create: if
        sameNewCompany() &&

        request.resource.data.keys().hasAll([
          'empresaId',
          'sucursalId',
          'productoId',
          'compraId',
          'numeroLote',
          'fechaVencimiento',
          'cantidadInicial',
          'cantidadDisponible',
          'estado'
        ]) &&

        request.resource.data.numeroLote is string &&
        request.resource.data.numeroLote.size() > 0 &&

        request.resource.data.fechaVencimiento is string &&

        request.resource.data.fechaVencimiento.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        ) &&

        request.resource.data.cantidadInicial is number &&
        request.resource.data.cantidadInicial > 0 &&

        request.resource.data.cantidadDisponible ==
          request.resource.data.cantidadInicial &&

        request.resource.data.estado == 'ACTIVO' &&

        get(
          /databases/$(database)/documents/productos/$(request.resource.data.productoId)
        ).data.empresaId == myCompany() &&

        get(
          /databases/$(database)/documents/productos/$(request.resource.data.productoId)
        ).data.controlaVencimiento == true &&

        (

          // ====================================
          // LOTES CREADOS DESDE COMPRAS
          // ====================================

          (
            hasPermission('compras.gestionar') &&

            request.resource.data.compraId is string &&

            request.resource.data.compraId.size() > 0 &&

            request.resource.data.get(
              'origen',
              ''
            ) != 'REGULARIZACION_INICIAL' &&

            getAfter(
              /databases/$(database)/documents/compras/$(request.resource.data.compraId)
            ).data.empresaId ==
              request.resource.data.empresaId &&

            getAfter(
              /databases/$(database)/documents/compras/$(request.resource.data.compraId)
            ).data.sucursalId ==
              request.resource.data.sucursalId
          )

          ||

          // ====================================
          // LOTES DE STOCK ANTIGUO
          // ====================================

          (
            hasPermission('inventario.ajustar') &&

            request.resource.data.compraId == null &&

            request.resource.data.origen ==
              'REGULARIZACION_INICIAL' &&

            request.resource.data.regularizacionId is string &&

            request.resource.data.usuarioId ==
              request.auth.uid &&

            request.resource.data.fechaRegistro ==
              request.time &&

            request.resource.data.fechaActualizacion ==
              request.time &&

            getAfter(
              rutaMovimiento(
                request.resource.data.regularizacionId
              )
            ).data.tipo == 'REGULARIZACION_LOTE' &&

            getAfter(
              rutaMovimiento(
                request.resource.data.regularizacionId
              )
            ).data.loteId == id &&

            getAfter(
              rutaMovimiento(
                request.resource.data.regularizacionId
              )
            ).data.empresaId ==
              request.resource.data.empresaId &&

            getAfter(
              rutaMovimiento(
                request.resource.data.regularizacionId
              )
            ).data.sucursalId ==
              request.resource.data.sucursalId &&

            getAfter(
              rutaMovimiento(
                request.resource.data.regularizacionId
              )
            ).data.productoId ==
              request.resource.data.productoId &&

            getAfter(
              rutaMovimiento(
                request.resource.data.regularizacionId
              )
            ).data.cantidad ==
              request.resource.data.cantidadInicial &&

            exists(
              rutaInventario(
                request.resource.data.sucursalId,
                request.resource.data.productoId
              )
            ) &&

            getAfter(
              rutaInventario(
                request.resource.data.sucursalId,
                request.resource.data.productoId
              )
            ).data.ultimaRegularizacionId ==
              request.resource.data.regularizacionId &&

            getAfter(
              rutaInventario(
                request.resource.data.sucursalId,
                request.resource.data.productoId
              )
            ).data.stock ==

            get(
              rutaInventario(
                request.resource.data.sucursalId,
                request.resource.data.productoId
              )
            ).data.stock
          )
        );

      // ========================================
      // ACTUALIZAR LOTES
      // ========================================

      allow update: if

        sameOnUpdate() &&

        resource.data.estado == 'ACTIVO' &&

        (

          // ====================================
          // VENTAS, DEVOLUCIONES Y ANULACIONES
          // ====================================

          (
            (
              hasAnyPermission(['ventas.registrar', 'ventas.ver'])
            ) &&

            request.resource.data.diff(
              resource.data
            ).affectedKeys().hasOnly([
              'cantidadDisponible',
              'fechaActualizacion'
            ]) &&

            request.resource.data.cantidadDisponible is number &&

            request.resource.data.cantidadDisponible >= 0 &&

            request.resource.data.cantidadDisponible <=
              resource.data.cantidadInicial &&

            request.resource.data.cantidadDisponible +
              resource.data.get('cantidadRetirada', 0) <=
              resource.data.cantidadInicial &&

            request.resource.data.fechaActualizacion ==
              request.time &&

            (

              // VENTA: DESCUENTA UNIDADES.

              (
                hasPermission('ventas.registrar') &&

                request.resource.data.cantidadDisponible <
                  resource.data.cantidadDisponible
              )

              ||

              // ANULACION O DEVOLUCION:
              // RESTAURA UNIDADES.

              (
                hasPermission('ventas.ver') &&

                request.resource.data.cantidadDisponible >
                  resource.data.cantidadDisponible
              )
            )
          )

          ||

          // ====================================
          // BAJAS POR VENCIMIENTO
          // ====================================

          (
            hasPermission('inventario.ajustar') &&

            request.resource.data.diff(
              resource.data
            ).affectedKeys().hasOnly([
              'cantidadDisponible',
              'cantidadRetirada',
              'ultimaBajaId',
              'fechaUltimaBaja',
              'fechaActualizacion'
            ]) &&

            request.resource.data.cantidadDisponible is number &&

            request.resource.data.cantidadDisponible >= 0 &&

            request.resource.data.cantidadDisponible <
              resource.data.cantidadDisponible &&

            request.resource.data.cantidadRetirada is number &&

            request.resource.data.cantidadRetirada ==

              resource.data.get('cantidadRetirada', 0) +

              resource.data.cantidadDisponible -

              request.resource.data.cantidadDisponible &&

            request.resource.data.cantidadRetirada <=
              resource.data.cantidadInicial &&

            request.resource.data.ultimaBajaId is string &&

            request.resource.data.ultimaBajaId !=
              resource.data.get('ultimaBajaId', '') &&

            request.resource.data.fechaUltimaBaja ==
              request.time &&

            request.resource.data.fechaActualizacion ==
              request.time &&

            // COMPROBAR MOVIMIENTO DE BAJA.

            getAfter(
              rutaMovimiento(
                request.resource.data.ultimaBajaId
              )
            ).data.tipo == 'BAJA_VENCIMIENTO' &&

            getAfter(
              rutaMovimiento(
                request.resource.data.ultimaBajaId
              )
            ).data.loteId == id &&

            getAfter(
              rutaMovimiento(
                request.resource.data.ultimaBajaId
              )
            ).data.empresaId ==
              resource.data.empresaId &&

            getAfter(
              rutaMovimiento(
                request.resource.data.ultimaBajaId
              )
            ).data.sucursalId ==
              resource.data.sucursalId &&

            getAfter(
              rutaMovimiento(
                request.resource.data.ultimaBajaId
              )
            ).data.productoId ==
              resource.data.productoId &&

            getAfter(
              rutaMovimiento(
                request.resource.data.ultimaBajaId
              )
            ).data.usuarioId ==
              request.auth.uid &&

            getAfter(
              rutaMovimiento(
                request.resource.data.ultimaBajaId
              )
            ).data.fechaRegistro ==
              request.time &&

            getAfter(
              rutaMovimiento(
                request.resource.data.ultimaBajaId
              )
            ).data.cantidad ==

              resource.data.cantidadDisponible -

              request.resource.data.cantidadDisponible &&

            // EL STOCK GENERAL DEBE DISMINUIR.

            getAfter(
              rutaInventario(
                resource.data.sucursalId,
                resource.data.productoId
              )
            ).data.stock ==

            get(
              rutaInventario(
                resource.data.sucursalId,
                resource.data.productoId
              )
            ).data.stock -

            (
              resource.data.cantidadDisponible -
              request.resource.data.cantidadDisponible
            )
          )
        );

      // NO ELIMINAR LOTES.

      allow delete: if false;
    }

    // ==========================================
    // R. CLIENTES
    // ==========================================

    match /clientes/{id} {

      allow read: if
        superAdmin() ||
        sameExistingCompany();

      allow create: if
        hasPermission('clientes.gestionar') &&
        sameNewCompany();

      allow update: if
        hasPermission('clientes.gestionar') &&
        sameOnUpdate();

      allow delete: if
        hasPermission('clientes.gestionar') &&
        sameExistingCompany();
    }

    // ==========================================
    // S. PROVEEDORES
    // ==========================================

    match /proveedores/{id} {

      allow read: if
        superAdmin() ||
        sameExistingCompany();

      allow create: if
        hasPermission('proveedores.gestionar') &&
        sameNewCompany();

      allow update: if
        hasPermission('proveedores.gestionar') &&
        sameOnUpdate();

      allow delete: if
        hasPermission('proveedores.gestionar') &&
        sameExistingCompany();
    }

    // ==========================================
    // T. COMPRAS
    // ==========================================

    match /compras/{id} {

      allow read: if
        superAdmin() ||
        (hasPermission('reportes.ver') && sameExistingCompany()) ||
        (
          hasPermission('compras.gestionar') &&
          sameExistingCompany()
        );

      allow create: if
        hasPermission('compras.gestionar') &&
        sameNewCompany();

      allow update: if
        hasPermission('compras.gestionar') &&
        sameOnUpdate();

      allow delete: if false;
    }

    match /detalleCompras/{id} {

      allow read: if
        superAdmin() ||
        (hasPermission('reportes.ver') && sameExistingCompany()) ||
        (
          hasPermission('compras.gestionar') &&
          sameExistingCompany()
        );

      allow create: if
        hasPermission('compras.gestionar') &&
        sameNewCompany();

      allow update, delete: if false;
    }

    // ==========================================
    // U. VENTAS
    // ==========================================

    match /ventas/{id} {

      allow read: if
        superAdmin() ||
        (hasPermission('reportes.ver') && sameExistingCompany()) ||
        (
          hasPermission('ventas.ver') &&
          sameExistingCompany()
        );

      allow create: if
        hasPermission('ventas.registrar') &&
        sameNewCompany() &&
        request.resource.data.usuarioId == request.auth.uid &&
        request.resource.data.estado == 'COMPLETADA' &&
        request.resource.data.fechaRegistro == request.time &&
        request.resource.data.subtotal is number &&
        request.resource.data.descuento is number &&
        request.resource.data.total is number &&
        request.resource.data.descuento >= 0 &&
        request.resource.data.total >= 0 &&
        request.resource.data.total <= request.resource.data.subtotal;

      // Una venta hecha no se edita: solo se puede anular, una vez y con nombre
      allow update: if
        hasPermission('ventas.ver') &&
        sameOnUpdate() &&
        resource.data.estado == 'COMPLETADA' &&
        request.resource.data.estado == 'ANULADA' &&
        request.resource.data.usuarioAnulacion == request.auth.uid &&
        request.resource.data.fechaAnulacion == request.time &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'usuarioAnulacion', 'fechaAnulacion']);

      allow delete: if false;
    }

    match /detalleVentas/{id} {

      allow read: if
        superAdmin() ||
        (hasPermission('reportes.ver') && sameExistingCompany()) ||
        (
          hasPermission('ventas.ver') &&
          sameExistingCompany()
        );

      allow create: if
        hasPermission('ventas.registrar') &&
        sameNewCompany();

      allow update, delete: if false;
    }

    // ==========================================
    // V. DEVOLUCIONES
    // ==========================================

    match /devoluciones/{id} {

      allow read: if
        superAdmin() ||
        (
          hasPermission('ventas.ver') &&
          sameExistingCompany()
        );

      // El sistema todavía no registra devoluciones
      allow write: if false;
    }

    // ==========================================
    // W. PROMOCIONES
    // ==========================================

    match /promociones/{id} {

      allow read: if
        superAdmin() ||
        sameExistingCompany();

      allow create: if
        hasPermission('promociones.gestionar') &&
        sameNewCompany();

      allow update: if
        hasPermission('promociones.gestionar') &&
        sameOnUpdate();

      allow delete: if
        hasPermission('promociones.gestionar') &&
        sameExistingCompany();
    }

    // ==========================================
    // X. METODOS DE PAGO
    // ==========================================

    match /metodosPago/{id} {

      allow read: if
        superAdmin() ||
        sameExistingCompany();

      allow create: if
        hasPermission('configuracion.gestionar') &&
        sameNewCompany();

      allow update: if
        hasPermission('configuracion.gestionar') &&
        sameOnUpdate();

      allow delete: if
        hasPermission('configuracion.gestionar') &&
        sameExistingCompany();
    }

    // ==========================================
    // Y. CAJAS
    // ==========================================

    match /cajas/{id} {

      allow read: if
        superAdmin() ||
        (hasPermission('reportes.ver') && sameExistingCompany()) ||
        (
          (
            hasAnyPermission(['caja.gestionar', 'ventas.registrar', 'compras.gestionar', 'finanzas.gestionar'])
          ) &&

          sameExistingCompany()
        );

      // Solo se abre si la sucursal quedó reservada para esta caja
      allow create: if
        hasPermission('caja.gestionar') &&
        sameNewCompany() &&
        request.resource.data.estado == 'ABIERTA' &&
        request.resource.data.usuarioAperturaId == request.auth.uid &&
        request.resource.data.saldoInicial is number &&
        request.resource.data.saldoInicial >= 0 &&
        getAfter(
          /databases/$(database)/documents/cajasAbiertas/$(request.resource.data.sucursalId)
        ).data.cajaId == id;

      // Lo único que cambia en una caja es su cierre, una sola vez
      allow update: if
        hasPermission('caja.gestionar') &&
        sameOnUpdate() &&
        resource.data.estado == 'ABIERTA' &&
        request.resource.data.estado == 'CERRADA' &&
        request.resource.data.usuarioCierreId == request.auth.uid &&
        request.resource.data.fechaCierre == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'totalIngresos', 'totalEgresos', 'saldoFinal', 'saldoContado',
          'diferencia', 'usuarioCierreId', 'estado', 'fechaCierre',
          'fechaActualizacion'
        ]);

      allow delete: if false;
    }

    // Qué caja tiene abierta cada sucursal: evita dos cajas a la vez
    match /cajasAbiertas/{sucursalId} {

      allow get: if
        hasPermission('caja.gestionar') &&
        (resource == null || sameExistingCompany());

      allow create: if
        hasPermission('caja.gestionar') &&
        sameNewCompany() &&
        request.resource.data.usuarioId == request.auth.uid &&
        request.resource.data.sucursalId == sucursalId &&
        get(
          /databases/$(database)/documents/sucursales/$(sucursalId)
        ).data.empresaId == myCompany();

      allow update: if
        hasPermission('caja.gestionar') &&
        sameOnUpdate() &&
        request.resource.data.usuarioId == request.auth.uid &&
        request.resource.data.sucursalId == sucursalId &&
        get(
          /databases/$(database)/documents/cajas/$(resource.data.cajaId)
        ).data.estado == 'CERRADA';

      allow list, delete: if false;
    }

    // ==========================================
    // Z. MOVIMIENTOS DE CAJA
    // ==========================================

    match /movimientosCaja/{id} {

      allow read: if
        superAdmin() ||
        (hasPermission('reportes.ver') && sameExistingCompany()) ||
        (
          (
            hasAnyPermission(['caja.gestionar', 'finanzas.gestionar'])
          ) &&

          sameExistingCompany()
        );

      allow create: if
        sameNewCompany() &&
        request.resource.data.usuarioId == request.auth.uid &&
        request.resource.data.fechaRegistro == request.time &&
        request.resource.data.monto is number &&
        request.resource.data.monto >= 0 &&

        (
          hasAnyPermission([
            'caja.gestionar',
            'ventas.registrar',
            'compras.gestionar'
          ]) ||
          validFinanceCashMovement(id) ||
          (
            // Quien anula una venta en efectivo devuelve su importe exacto
            hasPermission('ventas.ver') &&
            request.resource.data.tipo == 'EGRESO' &&
            request.resource.data.categoria == 'ANULACION_VENTA' &&
            get(
              /databases/$(database)/documents/ventas/$(request.resource.data.referenciaId)
            ).data.estado == 'COMPLETADA' &&
            getAfter(
              /databases/$(database)/documents/ventas/$(request.resource.data.referenciaId)
            ).data.estado == 'ANULADA' &&
            getAfter(
              /databases/$(database)/documents/ventas/$(request.resource.data.referenciaId)
            ).data.total == request.resource.data.monto
          )
        );

      allow update, delete: if false;
    }

    // ==========================================
    // AA. GASTOS
    // ==========================================

    match /gastos/{id} {

      allow read: if
        superAdmin() ||
        (hasPermission('reportes.ver') && sameExistingCompany()) ||
        (
          hasPermission('caja.gestionar') &&
          sameExistingCompany()
        );

      allow create: if
        hasPermission('caja.gestionar') &&
        sameNewCompany();

      // El monto, la caja y la fecha de un gasto no se cambian; se anula
      allow update: if
        hasPermission('caja.gestionar') &&
        sameOnUpdate() &&
        resource.data.estado != 'ANULADO' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'concepto', 'categoria', 'observacion', 'estado',
          'fechaAnulacion', 'fechaActualizacion'
        ]);

      allow delete: if false;
    }

    // ==========================================
    // AD. CUENTAS POR PAGAR
    // ==========================================

    match /cuentasPagar/{id} {

      allow read: if
        superAdmin() ||
        (hasPermission('reportes.ver') && sameExistingCompany()) ||
        (
          hasPermission('finanzas.gestionar') &&
          sameExistingCompany()
        );

      allow create: if
        (
          hasAnyPermission(['compras.gestionar', 'finanzas.gestionar'])
        ) &&
        sameNewCompany();

      allow update: if
        hasPermission('finanzas.gestionar') &&
        sameOnUpdate() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['saldo', 'estadoCuenta', 'fechaActualizacion']) &&
        request.resource.data.saldo >= 0 &&
        request.resource.data.saldo <= resource.data.saldo;

      allow delete: if false;
    }

    // ==========================================
    // AE. PAGOS A PROVEEDORES
    // ==========================================

    match /pagosProveedor/{id} {

      allow read: if
        superAdmin() ||
        (
          hasPermission('finanzas.gestionar') &&
          sameExistingCompany()
        );

      allow create: if
        hasPermission('finanzas.gestionar') &&
        sameNewCompany();

      allow update, delete: if false;
    }

    // ==========================================
    // AF. NOTIFICACIONES
    // ==========================================

    match /notificaciones/{id} {

      // El dueño lee todos los avisos de su empresa. Cada trabajador lee solo
      // los activos que le tocan: los de todo el equipo, los de su cargo y los suyos.
      allow read: if
        superAdmin() ||
        (
          sameExistingCompany() &&
          (
            admin() ||
            (
              active() &&
              resource.data.estado == 'ACTIVO' &&
              (
                resource.data.audiencia == 'TODOS' ||
                (
                  resource.data.audiencia == 'ROL' &&
                  me().data.rolId != null &&
                  resource.data.rolId == me().data.rolId
                ) ||
                (
                  resource.data.audiencia == 'PERSONA' &&
                  resource.data.destinatarioId == request.auth.uid
                )
              )
            )
          )
        );

      allow create: if
        admin() &&
        sameNewCompany();

      allow update: if
        admin() &&
        sameOnUpdate();

      allow delete: if
        admin() &&
        sameExistingCompany();
    }

    // ==========================================
    // AG. NOTIFICACIONES GLOBALES
    // ==========================================

    match /notificacionesGlobales/{id} {

      allow write: if superAdmin();

      // Los avisos activos los leen los usuarios de su audiencia.
      allow read: if
        superAdmin() ||
        (
          active() &&
          resource.data.estado == 'ACTIVO' &&
          (
            resource.data.audiencia == 'TODOS' ||
            (resource.data.audiencia == 'ADMINS' && admin()) ||
            (resource.data.audiencia == 'TRABAJADORES' && worker())
          )
        );
    }

    // ==========================================
    // AH. RESPALDOS
    // ==========================================

    match /respaldos/{id} {

      allow read, create: if superAdmin();

      allow update, delete: if false;
    }

    // ==========================================
    // AI. AUDITORIA
    // ==========================================

    match /auditorias/{id} {

      allow read: if
        superAdmin() ||
        (
          hasPermission('auditoria.ver') &&
          sameExistingCompany()
        );

      // Nadie escribe un registro a nombre de otra persona ni con otra hora
      allow create: if
        request.resource.data.usuarioId == request.auth.uid &&
        request.resource.data.fecha == request.time &&
        (
          superAdmin() ||
          sameNewCompany()
        );

      allow update, delete: if false;
    }

    // ==========================================
    // AJ. BLOQUEAR ACCESOS NO AUTORIZADOS
    // ==========================================

    match /{document=**} {

      allow read, write: if false;
    }

  }
}